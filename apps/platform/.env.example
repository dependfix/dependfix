# ==========================================
# dependfix 平台环境变量示例文件（极简 / 快速启动版）
# ==========================================
# 提示：本文件仅含快速启动所需的最小配置。完整变量见 apps/platform/.env.full.example。
# 用法：cp .env.example .env && 编辑下方 [必填] 项。
#
# ⚠️ 注入方式（重要）：默认 docker-compose.yml **无 env_file**，仅把一组白名单变量经 `${...}` 插值转发进容器
#   （compose 名 → 容器名）：PORT · PUID/PGID · AUTH_SECRET→NUXT_AUTH_SECRET · DATABASE_PATH（硬编码 /app/data/…） ·
#   DATABASE_MIGRATIONS_RUN · NUXT_ENCRYPTION_KEY · REGISTRATION_DISABLED→NUXT_REGISTRATION_DISABLED ·
#   NUXT_PUBLIC_BETTER_AUTH_URL · NUXT_REDIS_URL（硬编码 redis://redis:6379） ·
#   QUEUE_ENABLED/QUEUE_JOB_RETRIES/QUEUE_BACKOFF_MS→NUXT_* ·
#   QUEUE_WORKER→DEPENDFIX_QUEUE_WORKER · IN_PROCESS_WORKER→NUXT_IN_PROCESS_WORKER ·
#   DEPENDFIX_IMAGE/DEPENDFIX_BUILD_IMAGE。
#   白名单**之外**的变量（如 SMTP_* / AUTH_MODE / OIDC_* / DATABASE_TYPE / SANDBOX_* / BACKUP_* 等）
#   需自行追加到 compose 的 `environment:`（Nuxt runtimeConfig 变量须用 NUXT_ 前缀）或用 `docker run -e`。

# ------------------------------------------
# 1. 必填 (Essential)
# ------------------------------------------

# [必填-生产] better-auth 会话签名密钥。生产必须设为随机长字符串（`openssl rand -hex 32`）。
AUTH_SECRET=change-me-to-a-random-secret

# [必填-用凭据功能] 凭据加密密钥（AES-256-GCM，32 字节随机值）。留空则禁用凭据管理功能。
NUXT_ENCRYPTION_KEY=

# ------------------------------------------
# 2. 基础 (Basic)
# ------------------------------------------

# [可选] 平台监听端口（默认 3000）。
PORT=3000

# [建议-反代/HTTPS 必填] 对外访问地址。用于 OAuth 回调与 trustedOrigins 收紧；
# 未设置时 trustedOrigins 回退通配兜底（http://* / https://*），生产应显式设置。
NUXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000

# [可选] SQLite 数据库文件路径（相对平台工作目录；首次启动自动建表，默认 data/dependfix.sqlite）。
DATABASE_PATH=data/dependfix.sqlite

# ------------------------------------------
# 3. 首次部署提示 (First-run)
# ------------------------------------------

# ⚠️ 首次部署需保持 REGISTRATION_DISABLED=false 注册首个管理员，之后再设为 true 关闭注册，否则平台无管理员。

# ------------------------------------------
# 4. 常见可选配置（详见 .env.full.example）
# ------------------------------------------

# 关闭注册（保留登录）：公开部署时设为 true（compose 名 REGISTRATION_DISABLED → 容器 NUXT_REGISTRATION_DISABLED）。
# REGISTRATION_DISABLED=true

# 认证部署模式（enterprise | public，缺省 public）。白名单外变量：需追加到 compose environment（容器名 NUXT_AUTH_MODE）。
# AUTH_MODE=public

# 扫描队列（默认 auto：Redis 可达且存在消费者时异步，否则自动降级同步）。
# QUEUE_ENABLED=auto
# 队列执行进程隔离（容器入口默认 1：独立 worker 进程消费队列，消除 BullMQ 锁续期失败）。
# compose 名为 QUEUE_WORKER（→ 容器 DEPENDFIX_QUEUE_WORKER=1）。
# QUEUE_WORKER=1

# 依赖更新 PR check 状态监测总开关（默认 false）。白名单外变量：需追加到 compose environment。
# ACTION_STATUS_MONITOR_ENABLED=false

# Docker 运行身份（默认 100:101 = 镜像内 dependfix 用户；NAS / 多用户场景设为宿主 uid:gid）。
# PUID=1000
# PGID=1000

# 完整变量（数据库 / 认证 OAuth / OIDC / SMTP / Redis / 执行器沙箱 / 备份 / AI / 通知等）见：
#   apps/platform/.env.full.example + docs/guide/configuration.md「平台配置」段
