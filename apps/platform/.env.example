# ===== dependfix 平台环境变量 =====

# 平台监听端口（Nuxt 默认 3000；Docker 内默认 3000）
PORT=3000

# better-auth 密钥（生产必须设置为随机长字符串）
AUTH_SECRET=change-me-to-a-random-secret

# SQLite 数据库文件路径（相对平台工作目录）
DATABASE_PATH=data/dependfix.sqlite

# 凭据加密密钥（AES-256-GCM，凭据管理功能使用；生产必须设置为 32 字节随机值）
# ENCRYPTION_KEY=

# SMTP（可选）：配置后启用邮箱验证与密码重置邮件；未配置自动跳过验证
# SMTP_HOST=smtp.example.com
# SMTP_PORT=465
# SMTP_USER=user@example.com
# SMTP_PASS=password
# SMTP_FROM=dependfix <no-reply@example.com>

# 认证基础 URL（反向代理/容器部署时显式指定）
# NUXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000

# 关闭注册（保留登录）：公开部署时设为 true，注册接口返回禁用提示（首个管理员需在开放期注册）
# REGISTRATION_DISABLED=true

# 认证部署模式（enterprise | public，互斥二选一，缺省 public）：
# - enterprise：邮箱密码 + OIDC SSO，邮箱域名白名单注册准入（ALLOWED_EMAIL_DOMAINS）
# - public：邮箱密码 + GitHub/Google OAuth，邮箱域名黑名单注册准入（BLOCKED_EMAIL_DOMAINS）
# AUTH_MODE=public
#
# 注意：构建期 env（如 AUTH_MODE）在 nuxt.config 求值时烘焙进产物；
# Docker 容器运行时注入需用 NUXT_ 前缀（NUXT_AUTH_MODE / NUXT_ALLOWED_EMAIL_DOMAINS /
# NUXT_BLOCKED_EMAIL_DOMAINS / NUXT_REGISTRATION_DISABLED），否则不生效（静默回退默认值）。
# 前端可见配置用 NUXT_PUBLIC_ 前缀（NUXT_PUBLIC_AUTH_MODE / NUXT_PUBLIC_REGISTRATION_DISABLED 等）。

# 邮箱域名白名单（enterprise 模式；逗号分隔，小写）。白名单为空 = 完全关闭自动开通
# （邮箱注册 + OIDC 自动开通均被 hook 拒绝，仅首用户 admin 路径放行）
# ALLOWED_EMAIL_DOMAINS=example.com,corp.example.org

# 邮箱域名黑名单（public 模式；逗号分隔，小写）。命中黑名单的邮箱拒绝注册（含 OAuth 自动开通）
# BLOCKED_EMAIL_DOMAINS=mailinator.com,temp-mail.org

# GitHub OAuth（public 模式；clientId 与 clientSecret 均配置才启用该登录方式，否则登录页自动隐藏）
# 凭据仅从根级 env 读取（构建期烘焙 + 运行时 NUXT_GITHUB_CLIENT_ID 覆盖），不走 NUXT_PUBLIC_ 通道
# 回调地址由 better-auth 按请求 Host 自动构造（默认 ${NUXT_PUBLIC_BETTER_AUTH_URL}/api/auth/callback/github；
# 反代场景需透传 Host，或部署侧保证回调一致）
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# Google OAuth（public 模式；clientId 与 clientSecret 均配置才启用该登录方式，否则登录页自动隐藏）
# 凭据仅从根级 env 读取（构建期烘焙 + 运行时 NUXT_GOOGLE_CLIENT_ID 覆盖），不走 NUXT_PUBLIC_ 通道
# 回调地址由 better-auth 按请求 Host 自动构造（默认 ${NUXT_PUBLIC_BETTER_AUTH_URL}/api/auth/callback/google；
# 反代场景需透传 Host，或部署侧保证回调一致）
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# OIDC SSO（enterprise 模式；OIDC_DISCOVERY_URL + clientId + clientSecret 均配置才启用，否则登录页自动隐藏）
# discovery 端点自动发现（authorization/token/userinfo/jwks）；无 discovery 的 IdP 可用 OIDC_ISSUER 或
# 手动声明 OIDC_AUTHORIZATION_URL / OIDC_TOKEN_URL / OIDC_USERINFO_URL 覆盖
# 回调地址由 better-auth 按请求 Host 自动构造（默认 ${NUXT_PUBLIC_BETTER_AUTH_URL}/api/auth/oauth2/callback/oidc）
# 注意：requireIssuerValidation 启用（防 issuer 混淆）要求 IdP 回调回显 iss 参数（RFC 9207，
# Google/Auth0/Okta 等现代 IdP 支持）；老式/自建 IdP 不支持时登录将被拒（issuer_missing）
# OIDC_DISCOVERY_URL=
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_ISSUER=
# OIDC_AUTHORIZATION_URL=
# OIDC_TOKEN_URL=
# OIDC_USERINFO_URL=
# OIDC_SCOPES=openid,profile,email

# ===== 扫描任务队列（渐进式降级）=====
# BullMQ 队列：Redis 可达且版本 >= 5.0 时扫描异步执行（入队立即返回 + 前端轮询）；
# Redis 不可用或版本过低时自动降级同步执行（既有行为，API 兼容）
# 本地开发：确保本机 Redis >= 5.0（旧版本 3.x 会触发降级，日志提示 version_too_old）
# 运行时覆盖需 NUXT_ 前缀（构建产物烘焙默认值）：NUXT_REDIS_URL / NUXT_QUEUE_ENABLED 等
# REDIS_URL=redis://127.0.0.1:6379
# QUEUE_ENABLED=auto
#   - auto（默认）：Redis 探测决定 async/sync
#   - true：强制队列（Redis 不可用时降级同步 + warn）
#   - false：强制同步
# QUEUE_JOB_RETRIES=3
# QUEUE_BACKOFF_MS=5000
# 单容器直接部署形态：Nuxt 进程内消费队列（无需独立 worker 进程；SQLite 下推荐此形态）
# IN_PROCESS_WORKER=true

# ===== 环境容器审计通知（sandbox 启动降级 / 运行时失败）=====
# DEPENDFIX_ENV_ALERT_RECIPIENTS（可选）：环境告警邮件收件人列表（逗号分隔）
# 设置后覆盖默认（默认查询 organization 内 admin + org_admin 角色 + banned=false 用户邮箱）
# DEPENDFIX_LOCALE（可选）：通知邮件语言（'zh-CN' | 'en-US'；非法值回退 zh-CN）
# DEPENDFIX_ENV_ALERT_RECIPIENTS=ops@example.com,admin@example.com
# DEPENDFIX_LOCALE=zh-CN

# ===== 数据库迁移（生产环境）=====
# DATABASE_MIGRATIONS_RUN（默认 true）：production 启动自动执行 pending migration；
# 测试环境默认 false（synchronize 直接建表即可；migration 仅生产路径）。
# 关闭后 schema 变更需手动执行：`pnpm --filter @dependfix/platform exec typeorm migration:run`
# DATABASE_MIGRATIONS_RUN=true
