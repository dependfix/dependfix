# ===== dependfix 平台环境变量 =====

# 平台监听端口（Nuxt 默认 3000；Docker 内默认 3000）
PORT=3000

# ===== Docker / docker-compose 部署 =====
# 运行身份（控制 /app/data 数据卷与 $HOME 的宿主侧所有权）：
# - 默认 100:101 = 镜像内 dependfix 用户；NAS / 多用户场景设为宿主用户 uid:gid
# - 解析为 0（PUID=0 / PGID=0）时入口 fail-closed 拒绝启动（保持非 root 执行基线）
# PUID=1000
# PGID=1000
# chown 作用域默认仅允许 /app 与 /home 下的规范化路径；特殊挂载点需放开时设 1（高级用法）
# DEPENDFIX_ALLOW_ANY_DIR=1
# 镜像选择（apps/platform/docker-compose.yml 默认 caomeiyouren/dependfix:latest）：
# - 可换 registry：ghcr.io/dependfix/dependfix:latest 或阿里云 ACR 地址
# - 本地构建覆盖文件（docker-compose.build.yml）使用 DEPENDFIX_BUILD_IMAGE（默认 caomeiyouren/dependfix:local）
# DEPENDFIX_IMAGE=caomeiyouren/dependfix:latest
# DEPENDFIX_BUILD_IMAGE=caomeiyouren/dependfix:local

# better-auth 密钥（生产必须设置为随机长字符串）
AUTH_SECRET=change-me-to-a-random-secret

# SQLite 数据库文件路径（相对平台工作目录）
DATABASE_PATH=data/dependfix.sqlite

# 凭据加密密钥（AES-256-GCM，凭据管理功能使用；生产必须设置为 32 字节随机值）
# 运行时通过 Nuxt runtimeConfig 读取，Docker 容器运行时覆盖需 NUXT_ 前缀
# NUXT_ENCRYPTION_KEY=

# SMTP（可选）：配置后启用邮箱验证与密码重置邮件；未配置自动跳过验证
# SMTP_HOST=smtp.example.com
# SMTP_PORT=465
# SMTP_USER=user@example.com
# SMTP_PASS=password
# SMTP_FROM=dependfix <no-reply@example.com>

# 认证基础 URL（反向代理/容器部署时显式指定）
# NUXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000

# 关闭注册（保留登录）：公开部署时设为 true，注册接口返回禁用提示（首个管理员需在开放期注册）
# REGISTRATION_DISABLED=true

# 认证部署模式（enterprise | public，互斥二选一，缺省 public）：
# - enterprise：邮箱密码 + OIDC SSO，邮箱域名白名单注册准入（ALLOWED_EMAIL_DOMAINS）
# - public：邮箱密码 + GitHub/Google OAuth，邮箱域名黑名单注册准入（BLOCKED_EMAIL_DOMAINS）
# AUTH_MODE=public
#
# 注意：构建期 env（如 AUTH_MODE）在 nuxt.config 求值时烘焙进产物；
# Docker 容器运行时注入需用 NUXT_ 前缀（NUXT_AUTH_MODE / NUXT_ALLOWED_EMAIL_DOMAINS /
# NUXT_BLOCKED_EMAIL_DOMAINS / NUXT_REGISTRATION_DISABLED），否则不生效（静默回退默认值）。
# 前端可见配置用 NUXT_PUBLIC_ 前缀（NUXT_PUBLIC_AUTH_MODE / NUXT_PUBLIC_REGISTRATION_DISABLED 等）。

# 邮箱域名白名单（enterprise 模式；逗号分隔，小写）。白名单为空 = 完全关闭自动开通
# （邮箱注册 + OIDC 自动开通均被 hook 拒绝，仅首用户 admin 路径放行）
# ALLOWED_EMAIL_DOMAINS=example.com,corp.example.org

# 邮箱域名黑名单（public 模式；逗号分隔，小写）。命中黑名单的邮箱拒绝注册（含 OAuth 自动开通）
# BLOCKED_EMAIL_DOMAINS=mailinator.com,temp-mail.org

# GitHub OAuth（public 模式；clientId 与 clientSecret 均配置才启用该登录方式，否则登录页自动隐藏）
# 凭据仅从根级 env 读取（构建期烘焙 + 运行时 NUXT_GITHUB_CLIENT_ID 覆盖），不走 NUXT_PUBLIC_ 通道
# 回调地址由 better-auth 按请求 Host 自动构造（默认 ${NUXT_PUBLIC_BETTER_AUTH_URL}/api/auth/callback/github；
# 反代场景需透传 Host，或部署侧保证回调一致）
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# Google OAuth（public 模式；clientId 与 clientSecret 均配置才启用该登录方式，否则登录页自动隐藏）
# 凭据仅从根级 env 读取（构建期烘焙 + 运行时 NUXT_GOOGLE_CLIENT_ID 覆盖），不走 NUXT_PUBLIC_ 通道
# 回调地址由 better-auth 按请求 Host 自动构造（默认 ${NUXT_PUBLIC_BETTER_AUTH_URL}/api/auth/callback/google；
# 反代场景需透传 Host，或部署侧保证回调一致）
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# OIDC SSO（enterprise 模式；OIDC_DISCOVERY_URL + clientId + clientSecret 均配置才启用，否则登录页自动隐藏）
# discovery 端点自动发现（authorization/token/userinfo/jwks）；无 discovery 的 IdP 可用 OIDC_ISSUER 或
# 手动声明 OIDC_AUTHORIZATION_URL / OIDC_TOKEN_URL / OIDC_USERINFO_URL 覆盖
# 回调地址由 better-auth 按请求 Host 自动构造（默认 ${NUXT_PUBLIC_BETTER_AUTH_URL}/api/auth/oauth2/callback/oidc）
# 注意：requireIssuerValidation 启用（防 issuer 混淆）要求 IdP 回调回显 iss 参数（RFC 9207，
# Google/Auth0/Okta 等现代 IdP 支持）；老式/自建 IdP 不支持时登录将被拒（issuer_missing）
# OIDC_DISCOVERY_URL=
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_ISSUER=
# OIDC_AUTHORIZATION_URL=
# OIDC_TOKEN_URL=
# OIDC_USERINFO_URL=
# OIDC_SCOPES=openid,profile,email

# ===== 扫描任务队列（渐进式降级，含消费者维度）=====
# BullMQ 队列：Redis 可达、版本 >= 5.0 且存在消费者时扫描异步执行（入队立即返回 + 前端轮询）；
# 否则自动降级同步执行（既有行为，API 兼容）。
# 消费者两种形态：① 独立 worker 进程（容器部署默认，见下 QUEUE_WORKER）；② 进程内 worker（IN_PROCESS_WORKER=true，单进程部署）。
# 本地开发：确保本机 Redis >= 5.0（旧版本 3.x 会触发降级，日志提示 version_too_old）
# 运行时覆盖需 NUXT_ 前缀（构建产物烘焙默认值）：NUXT_REDIS_URL / NUXT_QUEUE_ENABLED / NUXT_IN_PROCESS_WORKER 等
# REDIS_URL=redis://127.0.0.1:6379
# QUEUE_ENABLED=true
#   - auto：Redis 可用且本进程消费队列才异步；无消费者时自动降级同步（避免入队后无人消费的静默挂起）
#   - true：强制异步（独立 worker 进程 / 外部 worker 拓扑）；Redis 不可用时降级同步 + warn
#   - false：强制同步
# QUEUE_JOB_RETRIES=3
# QUEUE_BACKOFF_MS=5000
# 队列执行进程隔离（仅容器入口 docker/entrypoint.sh 消费；直接 node 启动无效）。默认 1：
#   1 = 入口启动独立 worker 进程消费队列、HTTP 进程不消费 → HTTP event loop 不再被扫描执行阻塞，
#       消除 BullMQ 锁续期失败（stalled 重排，见 docs/standards/platform.md §10.6）；
#   0 = 单进程形态，由下方 IN_PROCESS_WORKER 决定是否进程内消费。
# QUEUE_WORKER=1
# 进程内 worker（单进程部署的唯一消费者；DEPENDFIX_QUEUE_WORKER=0 时生效）：true 时本进程消费队列。
# 注意：auto 模式下设为 false 且无独立 worker 进程时会降级同步。
# IN_PROCESS_WORKER=true

# ===== 环境容器审计通知（sandbox 启动降级 / 运行时失败）=====
# DEPENDFIX_ENV_ALERT_RECIPIENTS（可选）：环境告警邮件收件人列表（逗号分隔）
# 设置后覆盖默认（默认查询 organization 内 admin + org_admin 角色 + banned=false 用户邮箱）
# DEPENDFIX_LOCALE（可选）：通知邮件语言（'zh-CN' | 'en-US'；非法值回退 zh-CN）
# DEPENDFIX_ENV_ALERT_RECIPIENTS=ops@example.com,admin@example.com
# DEPENDFIX_LOCALE=zh-CN

# ===== 数据库迁移（生产环境）=====
# DATABASE_MIGRATIONS_RUN（镜像内默认 true，应用源码默认 false）：启动时是否自动执行 pending migration。
# - Docker 镜像已内置该默认（直接 docker run / 旧 compose / 新 compose 均自动建表），可用 false 覆盖
# - 非 Docker 部署 / 需要完全手动控制时，显式开启或改手动执行
# 三条显式路径（语义不同）：
# - 启动时自动执行：DATABASE_MIGRATIONS_RUN=true（TypeORM DataSource.initialize 阶段自动跑 pending migration）
# - 一键初始化（幂等，全新库建全部基础表）：pnpm db:init
# - 手动单次执行（在 apps/platform 下）：pnpm db:migrate（`pnpm db:migrate:show` 只读预览待执行，
#   `pnpm db:migrate:revert -- --yes` 回退最近一次）
# Docker 一次性初始化（关闭自动迁移时）：apps/platform/docker/init-db.sh
# 全新空库由基线迁移（CreateInitialSchema）按实体元数据创建 13 张业务表；存量库仅补 pending。
# 详见 docs/standards/development.md §5.1.19 TypeORM 1.x synchronize 与 migrationsRun 反模式禁止
# + apps/platform/server/database/scripts/README.md §db-init / §db-migrate。
# DATABASE_MIGRATIONS_RUN=true

# DATABASE_SYNCHRONIZE（默认 false）：开关 TypeORM 自动 schema 同步。
# dev 模式默认关闭（synchronize 不再依赖 isDev），需要手动开启才能让 entity 变更
# 自动同步到 SQLite；生产环境永远需要显式开启。详见 docs/standards/development.md §5.1.19。
# DATABASE_SYNCHRONIZE=true

# ===== PR Check 状态监测（M24.1 Phase 2；详见 docs/plan/todo.md §M24.1）=====
# ACTION_STATUS_MONITOR_ENABLED（默认 false）：依赖更新 PR check 状态监测服务总开关。
# 关闭时，pr-check 类型 schedule 即使启用 cron 触发，triggerPrCheckSchedule 也会 log warn 后跳过。
# 启用前需满足：
# - 至少有一个 Repository 配置 PAT credential（classic-pat / fine-grained-pat）
# - 当前组织内有 dependfix / dependabot PR 活动（避免空轮询）
# 启用后需重启进程使 env 生效。
# ACTION_STATUS_MONITOR_ENABLED=false
