# ==========================================
# dependfix 平台环境变量完整示例（apps/platform）
# ==========================================
# 说明：
# - 本文件为「完整版」，列出平台**全部**可配置环境变量（按逻辑分节，标注 [必填] / [可选] + 默认值）。
# - 快速启动只需最小集合，见 apps/platform/.env.example（极简版）。
# - 完整变量口径见 docs/guide/configuration.md「平台配置」段与 docs/guide/deployment.md。
# - 用法：cp .env.full.example .env && 按需编辑（compose 从 apps/platform/.env 读取并注入容器）。
#
# ⚠️ 注入方式（关键）：
# - 默认 docker-compose.yml **无 env_file**，仅把一组白名单变量经 `${...}` 插值转发进容器
#   （compose 名 → 容器名）：PORT · PUID/PGID · AUTH_SECRET→NUXT_AUTH_SECRET · DATABASE_PATH ·
#   DATABASE_MIGRATIONS_RUN · NUXT_ENCRYPTION_KEY · REGISTRATION_DISABLED→NUXT_REGISTRATION_DISABLED ·
#   NUXT_PUBLIC_BETTER_AUTH_URL · NUXT_REDIS_URL(硬编码) · QUEUE_ENABLED/QUEUE_JOB_RETRIES/QUEUE_BACKOFF_MS→NUXT_* ·
#   QUEUE_WORKER→DEPENDFIX_QUEUE_WORKER · IN_PROCESS_WORKER→NUXT_IN_PROCESS_WORKER · DEPENDFIX_IMAGE/DEPENDFIX_BUILD_IMAGE。
#   本文件列出的**白名单外**变量（SMTP_* / AUTH_MODE / OIDC_* / DATABASE_TYPE|URL|SSL|SYNCHRONIZE / BACKUP_* /
#   RUN_WORK_ROOT / SANDBOX_* / DEPENDFIX_AI_* / ACTION_STATUS_MONITOR_ENABLED / 通知类等）**默认不会**进容器，
#   需自行追加到 compose 的 `environment:`（Nuxt runtimeConfig 变量须用 `NUXT_` 前缀）或用 `docker run -e` 注入。
# - Nuxt 运行时覆盖只认 `NUXT_` 前缀：构建期烘焙的 env（如 AUTH_MODE）运行期须用 `NUXT_AUTH_MODE` 才生效；
#   直读 `process.env` 的服务端变量（如 DATABASE_* / CLONE_* / DEPENDFIX_*）按原名注入即可。

# ------------------------------------------
# 1. 基础与必填 (Essential)
# ------------------------------------------

# [必填-生产] better-auth 会话签名密钥。生产必须设为随机长字符串；可用 `openssl rand -hex 32` 生成。
AUTH_SECRET=change-me-to-a-random-secret

# [必填-用凭据功能] 凭据加密密钥（AES-256-GCM，32 字节随机值）。留空则禁用凭据管理功能。
# 容器内名为 NUXT_ENCRYPTION_KEY（compose 同名注入）。
NUXT_ENCRYPTION_KEY=

# [可选] 平台监听端口（Nuxt 默认 3000；Docker 内默认 3000）。
PORT=3000

# [建议-反代/HTTPS 必填] 对外访问地址。用于 OAuth 回调与 better-auth trustedOrigins 收紧。
# 未设置时 trustedOrigins 回退到通配兜底（http://* / https://*，便于快速启动，生产应显式设置）。
NUXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000

# [可选] 兼容旧变量名（trustedOrigins 读取回退）。新部署请统一用 NUXT_PUBLIC_BETTER_AUTH_URL。
# NUXT_PUBLIC_BASE_URL=

# [可选] 新建仓库默认分支（构建期注入，运行期修改需重建镜像）。默认 main。
# NUXT_PUBLIC_DEFAULT_BRANCH=main
# DEFAULT_BRANCH=main

# [可选] 雪花 ID 机器 ID（0-1023）。默认取进程 PID 对 1024 取余；多实例部署建议显式指定避免碰撞。
# MACHINE_ID=

# ------------------------------------------
# 2. 数据库与备份 (Database & Backup)
# ------------------------------------------

# [可选] SQLite 数据库文件路径（相对平台工作目录）。默认 data/dependfix.sqlite。
# compose 默认注入 /app/data/dependfix.sqlite（配合命名卷）。
DATABASE_PATH=data/dependfix.sqlite

# [可选] 数据库类型（sqlite | postgres 等）。通常由 DATABASE_URL 自动推断，一般无需设置。
# DATABASE_TYPE=sqlite

# [可选] 数据库连接 URL（PostgreSQL 等非 SQLite 场景；SQLite 用 DATABASE_PATH）。
# DATABASE_URL=

# [可选] 数据库连接调节（一般无需设置）。
# DATABASE_SSL=false
# DATABASE_CHARSET=utf8
# DATABASE_TIMEZONE=local
# DATABASE_ENTITY_PREFIX=

# [可选] TypeORM 自动 schema 同步（默认 false）。⚠️ 生产环境**禁止**开启（详见开发规范 §5.1.19）。
# DATABASE_SYNCHRONIZE=false

# [可选] 启动时自动执行 pending migration。镜像内默认 true（全新库自动建表）；设 false 改手动执行。
# DATABASE_MIGRATIONS_RUN=true

# [内部] 迁移专用模式（初始化数据库后立即退出，成功 0 / 失败 1）。由 docker/init-db.sh 使用，勿手动设置为长期值。
# DEPENDFIX_MIGRATIONS_ONLY=false

# [可选] 跳过启动期数据库备份（默认 false）。仅 e2e 等无需备份的场景设 true。
# BACKUP_SKIP=false

# [可选] 启动期备份保留份数（默认 5），超出按 mtime 降序删除。
# BACKUP_RETENTION_COUNT=5

# ------------------------------------------
# 3. 认证与社交登录 (Authentication)
# ------------------------------------------

# [可选] 认证部署模式（enterprise | public，互斥二选一，缺省 public）。构建期烘焙，运行期用 NUXT_AUTH_MODE 覆盖。
# - enterprise：邮箱密码 + OIDC SSO，邮箱域名白名单注册准入（ALLOWED_EMAIL_DOMAINS）
# - public：邮箱密码 + GitHub/Google OAuth，邮箱域名黑名单注册准入（BLOCKED_EMAIL_DOMAINS）
# AUTH_MODE=public

# [可选] 关闭注册（保留登录）。公开部署建议 true（首个管理员需在开放期注册后再关闭）。
# REGISTRATION_DISABLED=true

# [可选] 邮箱域名白名单（enterprise 模式；逗号分隔）。白名单为空 = 完全关闭自动开通（仅首用户 admin 放行）。
# ALLOWED_EMAIL_DOMAINS=example.com,corp.example.org

# [可选] 邮箱域名黑名单（public 模式；逗号分隔）。命中黑名单的邮箱拒绝注册（含 OAuth 自动开通）。
# BLOCKED_EMAIL_DOMAINS=mailinator.com,temp-mail.org

# [可选] 前端可见的白名单域名提示（enterprise 模式；黑名单不暴露，最小暴露原则）。
# NUXT_PUBLIC_ALLOWED_EMAIL_DOMAINS=example.com

# [可选-反代/多域] better-auth trustedOrigins 显式列表（逗号分隔）。未设且未设 NUXT_PUBLIC_BETTER_AUTH_URL 时走通配兜底。
# BETTER_AUTH_TRUSTED_ORIGINS=https://dependfix.example.com

# [可选] GitHub OAuth（public 模式；clientId 与 clientSecret 均配置才启用，否则登录页自动隐藏）。
# 凭据仅从根级 env 读取（构建期烘焙 + 运行期 NUXT_GITHUB_CLIENT_ID/SECRET 覆盖），不走 NUXT_PUBLIC_ 通道。
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# [可选] Google OAuth（public 模式；clientId 与 clientSecret 均配置才启用，否则登录页自动隐藏）。
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# [可选] OIDC SSO（enterprise 模式；下述 discovery/issuer + clientId + clientSecret 均配置才启用）。
# 无 discovery 的 IdP 可用 OIDC_ISSUER 或手动声明 AUTHORIZATION/TOKEN/USERINFO_URL 覆盖。
# 注意：requireIssuerValidation 启用（防 issuer 混淆）要求 IdP 回调回显 iss 参数（RFC 9207）。
# OIDC_DISCOVERY_URL=
# OIDC_ISSUER=
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_AUTHORIZATION_URL=
# OIDC_TOKEN_URL=
# OIDC_USERINFO_URL=
# OIDC_SCOPES=openid,profile,email

# ------------------------------------------
# 4. 邮件发送 (SMTP)
# ------------------------------------------

# [可选] 配置后启用邮箱验证与密码重置邮件；未配置自动跳过验证。
# SMTP_HOST=smtp.example.com
# SMTP_PORT=465
# SMTP_USER=user@example.com
# SMTP_PASS=password
# SMTP_FROM=dependfix <no-reply@example.com>

# ------------------------------------------
# 5. 扫描队列与 Redis (Queue & Redis)
# ------------------------------------------

# [可选] Redis 连接地址。Redis 可达 + 版本 >= 5.0 + 存在消费者时扫描异步执行；否则自动降级同步。
# 注意：默认 compose 将容器内 NUXT_REDIS_URL 硬编码为 redis://redis:6379（指向内置 redis 服务）；
# 本变量仅在自行编排 / 直连进程（非默认 compose）时生效。
# REDIS_URL=redis://127.0.0.1:6379

# [可选] 队列开关（auto | true | false，缺省 auto；compose 名 QUEUE_ENABLED → 容器 NUXT_QUEUE_ENABLED）：
# - auto：Redis 可用且本进程消费队列才异步；无消费者时自动降级同步（避免入队后无人消费的静默挂起）
# - true：强制异步（独立 worker 进程 / 外部 worker 拓扑）；Redis 不可用时降级同步 + warn
# - false：强制同步
# QUEUE_ENABLED=auto

# [可选] 队列任务失败重试次数 / 退避间隔（毫秒）；留空用队列默认。compose 白名单内（→ 容器 NUXT_*）。
# QUEUE_JOB_RETRIES=3
# QUEUE_BACKOFF_MS=5000

# [可选] 队列执行进程隔离（仅容器入口 docker/entrypoint.sh 消费；直接 node 启动无效）。compose 默认 1（entrypoint 默认 0）。
# ⚠️ compose 名为 QUEUE_WORKER（→ 容器 DEPENDFIX_QUEUE_WORKER）；本文件因按「容器变量名」排列，此处仅说明映射。
#   1 = 入口启动独立 worker 进程消费队列、HTTP 进程不消费（消除 BullMQ 锁续期失败，见 platform.md §10.6）
#   0 = 单进程形态，由 IN_PROCESS_WORKER 决定是否进程内消费
# QUEUE_WORKER=1

# [容器内] worker 独立进程的内部 socket 路径（默认 /tmp/dependfix-queue-worker.sock）。白名单外，一般无需设置。
# DEPENDFIX_QUEUE_WORKER_SOCKET=/tmp/dependfix-queue-worker.sock

# [可选] 进程内 worker（单进程部署的唯一消费者）：true 时本进程消费队列。auto 模式下 false 且无独立 worker 会降级同步。
# 默认值来源差异：默认 compose 转发 IN_PROCESS_WORKER 默认 true；直连进程（nuxt.config）默认 false。
IN_PROCESS_WORKER=true

# [可选] 孤儿任务清理节拍（毫秒，默认 5 分钟）。生产保持默认；测试可设毫秒级。
# STALE_CLEANUP_INTERVAL_MS=300000

# ------------------------------------------
# 6. 执行器 / 沙箱 / 扫描 (Executor & Sandbox)
# ------------------------------------------

# [可选] 运行工作根目录（clone / 执行产物目录）。默认 data/runs。
# RUN_WORK_ROOT=data/runs

# [可选] 单仓库执行超时（毫秒，默认 1800000 = 30 分钟）。容器执行器与队列 Worker 锁时长同源联动；
# 越界（< 1 分钟或 > 24 小时）/ 非法值回退默认；env 变更需重启进程。
# EXECUTION_TIMEOUT_MS=1800000

# [可选] git clone 超时（毫秒，默认 300000）与最大重试次数（默认 3）。弱网环境可调大。
# CLONE_TIMEOUT_MS=300000
# CLONE_MAX_RETRIES=3

# [可选] 沙箱 OCI runtime（默认 runc）与沙箱镜像（默认 dependfix-platform:latest）。env 变更需重启进程。
# SANDBOX_RUNTIME=runc
# SANDBOX_IMAGE=dependfix-platform:latest

# [可选] 出站代理（引擎验证阶段使用；HTTP_PROXY / HTTPS_PROXY / ALL_PROXY）。
# HTTP_PROXY=
# HTTPS_PROXY=
# ALL_PROXY=

# [可选] 抑制「本地非容器执行」安全警告（默认 false；仅本地开发排障时使用）。
# DEPENDFIX_SUPPRESS_LOCAL_EXECUTION_WARNING=true

# [可选] 依赖更新 PR check 状态监测服务总开关（默认 false）。关闭时 pr-check 类型 schedule 触发会 log warn 后跳过。
# 启用前需：① 至少一个 Repository 配置 PAT credential；② 组织内有 dependfix/dependabot PR 活动。启用后需重启进程。
# ACTION_STATUS_MONITOR_ENABLED=false

# ------------------------------------------
# 7. AI 研判（平台扫描内引擎调用）
# ------------------------------------------

# [可选] 平台触发的扫描在引擎侧启用 AI breaking change 研判时使用（按组织级 AI 配置注入）。
# DEPENDFIX_AI_PROVIDER=openai
# DEPENDFIX_AI_MODEL=
# DEPENDFIX_AI_BASE_URL=
# DEPENDFIX_AI_API_URL=
# DEPENDFIX_AI_API_KEY=
# DEPENDFIX_AI_TRIGGER=

# ------------------------------------------
# 8. 通知 (Notification)
# ------------------------------------------

# [可选] 环境告警邮件收件人（逗号分隔）。设置后覆盖默认（默认查 organization 内 admin/org_admin + banned=false 用户邮箱）。
# DEPENDFIX_ENV_ALERT_RECIPIENTS=ops@example.com,admin@example.com

# [可选] 通知邮件语言（zh-CN | en-US；非法值回退 zh-CN）。
# DEPENDFIX_LOCALE=zh-CN

# ------------------------------------------
# 9. Docker / 部署 (Docker Deploy)
# ------------------------------------------

# [可选] 运行身份（控制 /app/data 数据卷与 $HOME 的宿主侧所有权）。默认 100:101 = 镜像内 dependfix 用户。
# 解析为 0（PUID=0 / PGID=0）时入口 fail-closed 拒绝启动（保持非 root 执行基线）。
# PUID=1000
# PGID=1000

# [可选] 运行用户名（缺省 dependfix）。一般无需设置。
# RUN_USER=dependfix

# [可选] chown 作用域默认仅允许 /app 与 /home 下的规范化路径；特殊挂载点需放开时设 1（高级用法）。
# DEPENDFIX_ALLOW_ANY_DIR=1

# [可选] 镜像选择（docker-compose.yml 默认 caomeiyouren/dependfix:latest；可换 ghcr.io / 阿里云 ACR 地址）。
# DEPENDFIX_IMAGE=caomeiyouren/dependfix:latest

# [可选] 本地构建覆盖文件（docker-compose.build.yml）使用（默认 caomeiyouren/dependfix:local）。
# DEPENDFIX_BUILD_IMAGE=caomeiyouren/dependfix:local

# [可选] 部署脚本使用本地构建镜像（1 = docker-compose.build.yml）。
# DEPENDFIX_USE_LOCAL_BUILD=1

# ------------------------------------------
# 10. 内部 / 测试（生产勿设）
# ------------------------------------------

# 以下变量仅供构建 / 测试 / 本地排障，生产部署**不应**设置：
# NODE_ENV=production                    # 构建期固定值，勿覆盖
# E2E_TEST=true                          # e2e 测试门控（禁用鉴权钩子等）
# NUXT_E2E_FIXTURES_ALLOWED=true         # e2e fixtures 注入门控
# AUTH_TRACE=1                           # better-auth 事务追踪（诊断用）
# CI=true                                # CI 环境标记
# TEMP_REDIS_INTEGRATION=true            # BullMQ 集成测试门控（需真实 Redis >= 5）
# VITEST=true                            # vitest 运行时标记
# SET_COOKIE_TRACE_MODE / _BASE_URL / _FORMAT  # apps/platform/scripts/set-cookie-trace.mjs 专用脚本变量
