{
  "name": "@dependfix/platform",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "dependfix 管理平台（控制面）：仓库/凭据管理、扫描触发与结果展示。version 字段用于 release 链路的独立版本号与 CHANGELOG 锚定，不发布到 npm（private+npmPublishable=false），发布通道为 docker 镜像",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "nuxt dev -o",
    "build": "nuxt build",
    "preview": "nuxt preview",
    "typecheck": "nuxt typecheck",
    "lint": "cross-env NODE_ENV=production eslint . --fix --max-warnings 10",
    "lint:i18n": "cross-env NODE_ENV=production ESLINT_I18N=true eslint . --quiet",
    "lint:css": "stylelint \"**/*.{html,css,scss,sass,vue}\" --fix",
    "lint:css:check": "stylelint \"**/*.{html,css,scss,sass,vue}\"",
    "lint:md": "lint-md \"**/*.md\" --fix",
    "lint:md:check": "lint-md \"**/*.md\"",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium",
    "db:backfill:dry-run": "tsx server/database/scripts/backfill-scan-result.ts --dry-run",
    "db:backfill": "tsx server/database/scripts/backfill-scan-result.ts --apply",
    "db:restore": "tsx server/database/scripts/db-restore.ts",
    "db:doctor": "tsx server/database/scripts/db-doctor.ts",
    "trace:set-cookie": "node scripts/set-cookie-trace.mjs",
    "trace:set-cookie:md": "SET_COOKIE_TRACE_FORMAT=md node scripts/set-cookie-trace.mjs"
  },
  "dependencies": {
    "@dependfix/core": "workspace:*",
    "@dependfix/engine": "workspace:*",
    "@nuxtjs/i18n": "^10.6.0",
    "@octokit/rest": "^22.0.1",
    "@primeuix/themes": "^2.0.3",
    "@primevue/nuxt-module": "^4.5.5",
    "better-auth": "^1.7.2",
    "better-sqlite3": "^13.0.3",
    "bullmq": "^6.3.4",
    "chart.js": "^4.5.1",
    "cron-parser": "^5.10.0",
    "h3": "^1.15.11",
    "ioredis": "^6.0.0",
    "lodash-es": "^4.18.1",
    "lru-cache": "^11.5.2",
    "mysql2": "^3.24.3",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.0.0",
    "nuxt": "^4.5.1",
    "pg": "^8.23.0",
    "primeicons": "^7.0.0",
    "primelocale": "^2.5.0",
    "primevue": "^4.5.5",
    "reflect-metadata": "^0.2.2",
    "sass": "^1.104.0",
    "typeorm": "^1.1.1",
    "vue": "^3.5.42",
    "vue-router": "^5.3.1",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.23.1",
    "cross-env": "^10.0.0",
    "nock": "^14.0.17",
    "postcss": "^8.5.6",
    "stylelint": "17.15.0",
    "stylelint-config-cmyr": "^1.0.0",
    "tsx": "^4.23.13",
    "vue-tsc": "^3.3.11"
  }
}
