{
    "extends": "./.nuxt/tsconfig.json",
    "compilerOptions": {
        "experimentalDecorators": true,
        "emitDecoratorMetadata": true,
        "strictPropertyInitialization": false,
        "esModuleInterop": true
    },
    "include": [
        ".nuxt/nuxt.d.ts",
        "app/**/*",
        "server/**/*",
        "i18n/**/*",
        "playwright.config.ts",
        "tests/**/*"
    ]
}
