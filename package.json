{
  "name": "dependfix-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "一个自动化修复 github security 告警的方案",
  "author": "CaoMeiYouRen",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "changeset:publish": "changeset publish",
    "changelog": "node scripts/changelog.mjs",
    "distill:wisdom": "node scripts/distill-wisdom.mjs",
    "check:links": "node scripts/check-links.mjs",
    "lint": "cross-env NODE_ENV=production eslint . --fix --max-warnings 10",
    "lint:md": "lint-md \"*.md\" \"docs/**/*.md\" \".github/**/*.md\" \"packages/**/*.md\" --fix",
    "lint:md:check": "lint-md \"*.md\" \"docs/**/*.md\" \".github/**/*.md\" \"packages/**/*.md\"",
    "build": "pnpm -r build",
    "dev": "pnpm --filter dependfix dev",
    "start": "node packages/cli/dist/index.mjs",
    "start:tsx": "cross-env NODE_ENV=production tsx packages/cli/src/index.ts",
    "commit": "cz",
    "prepare": "husky",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "docs:dev": "pnpm --filter dependfix-docs dev",
    "docs:build": "pnpm --filter dependfix-docs build",
    "docs:preview": "pnpm --filter dependfix-docs preview"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@lint-md/cli": "2.2.4",
    "@types/node": "^26.1.2",
    "@vitest/coverage-v8": "^4.1.10",
    "commitizen": "^4.3.1",
    "commitlint": "^21.2.1",
    "commitlint-config-cmyr": "^1.0.0",
    "conventional-changelog": "^8.1.0",
    "conventional-changelog-cmyr-config": "^3.0.0",
    "cross-env": "^10.0.0",
    "cz-conventional-changelog-cmyr": "^2.0.0",
    "eslint": "^9.34.0",
    "eslint-config-cmyr": "^2.3.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  },
  "lint-staged": {
    "*.{js,ts}": [
      "npm run lint"
    ],
    "*.md": [
      "npm run lint:md",
      "git add"
    ]
  },
  "keywords": [
    "security",
    "dependabot-alerts",
    "code-scanning",
    "typescript"
  ],
  "homepage": "https://github.com/dependfix/dependfix#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dependfix/dependfix.git"
  },
  "bugs": {
    "url": "https://github.com/dependfix/dependfix/issues"
  },
  "changelog": {
    "language": "zh"
  }
}
