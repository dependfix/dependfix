{
  "name": "dependfix",
  "version": "0.3.3",
  "description": "一个自动化修复 github security 告警的方案",
  "author": "CaoMeiYouRen",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "security",
    "dependabot",
    "code-scanning",
    "dependabot-alerts",
    "cli"
  ],
  "homepage": "https://github.com/dependfix/dependfix#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dependfix/dependfix.git"
  },
  "bugs": {
    "url": "https://github.com/dependfix/dependfix/issues"
  },
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "bin": {
    "dependfix": "./dist/bin.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsdown",
    "prebuild": "rimraf dist",
    "dev": "cross-env NODE_ENV=development tsx watch src/index.ts",
    "dev:tsdown": "cross-env NODE_ENV=development tsdown --watch",
    "start": "node ./dist/index.mjs",
    "start:tsx": "cross-env NODE_ENV=production tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --fix"
  },
  "dependencies": {
    "@dependfix/core": "workspace:*",
    "@dependfix/engine": "workspace:*",
    "@dependfix/skills": "workspace:*",
    "@octokit/rest": "^22.0.1",
    "citty": "^0.2.2",
    "dayjs": "^1.11.23",
    "dotenv": "^17.4.2",
    "fs-extra": "^11.4.0",
    "isomorphic-unfetch": "^4.0.2",
    "lodash-es": "^4.18.1",
    "tslib": "^2.8.1",
    "yaml": "^2.9.0",
    "zx": "^8.8.5"
  },
  "devDependencies": {
    "@types/debug": "^4.1.13",
    "@types/fs-extra": "^11.0.4",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^26.2.0",
    "cross-env": "^10.0.0",
    "debug": "^4.4.3",
    "nock": "^14.0.17",
    "rimraf": "^6.1.3",
    "tsdown": "^0.22.14",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3"
  }
}