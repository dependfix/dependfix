{
    "name": "dependfix",
    "version": "0.1.0",
    "description": "一个自动化修复 github security 告警的方案",
    "author": "CaoMeiYouRen",
    "license": "MIT",
    "type": "module",
    "keywords": [
        "security",
        "dependabot",
        "code-scanning",
        "dependabot-alerts",
        "cli"
    ],
    "homepage": "https://github.com/dependfix/dependfix#readme",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/dependfix/dependfix.git"
    },
    "bugs": {
        "url": "https://github.com/dependfix/dependfix/issues"
    },
    "main": "./dist/index.cjs",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.mts",
    "exports": {
        ".": {
            "types": "./dist/index.d.mts",
            "import": "./dist/index.mjs",
            "require": "./dist/index.cjs"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist"
    ],
    "bin": {
        "dependfix": "./dist/bin.mjs"
    },
    "engines": {
        "node": ">=20"
    },
    "scripts": {
        "build": "tsdown",
        "prebuild": "rimraf dist",
        "dev": "cross-env NODE_ENV=development tsx watch src/index.ts",
        "dev:tsdown": "cross-env NODE_ENV=development tsdown --watch",
        "start": "node ./dist/index.mjs",
        "start:tsx": "cross-env NODE_ENV=production tsx src/index.ts",
        "typecheck": "tsc --noEmit",
        "lint": "eslint . --fix"
    },
    "dependencies": {
        "@dependfix/core": "workspace:*",
        "@octokit/rest": "^22.0.1",
        "citty": "^0.2.2",
        "dayjs": "^1.11.20",
        "dotenv": "^17.3.1",
        "fs-extra": "^11.3.4",
        "isomorphic-unfetch": "^4.0.2",
        "lodash-es": "^4.18.1",
        "p-queue": "^9.1.0",
        "tslib": "^2.8.1",
        "yaml": "^2.8.3",
        "zx": "^8.8.5"
    },
    "devDependencies": {
        "@octokit/request-error": "^7.1.0",
        "@types/debug": "^4.1.13",
        "@types/fs-extra": "^11.0.4",
        "@types/lodash-es": "^4.17.12",
        "@types/node": "^25.5.0",
        "cross-env": "^10.0.0",
        "debug": "^4.4.3",
        "nock": "^14.0.16",
        "rimraf": "^6.1.3",
        "tsdown": "^0.21.5",
        "tsx": "^4.21.0",
        "typescript": "^5.9.3"
    }
}
