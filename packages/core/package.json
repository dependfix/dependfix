{
    "name": "@dependfix/core",
    "version": "0.1.0",
    "description": "Core domain models and utilities for dependfix",
    "author": "CaoMeiYouRen",
    "license": "MIT",
    "type": "module",
    "main": "./dist/index.cjs",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.mts",
    "exports": {
        ".": {
            "import": "./dist/index.mjs",
            "require": "./dist/index.cjs",
            "types": "./dist/index.d.mts"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "tsdown",
        "prebuild": "rimraf dist",
        "dev": "tsdown --watch",
        "typecheck": "tsc --noEmit",
        "lint": "eslint . --fix"
    },
    "dependencies": {
        "tslib": "^2.8.1"
    },
    "devDependencies": {
        "rimraf": "^6.1.3",
        "tsdown": "^0.21.5",
        "typescript": "^5.9.3"
    }
}
