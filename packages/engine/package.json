{
    "name": "@dependfix/engine",
    "version": "0.1.0",
    "description": "dependfix 执行引擎：编排、采集、修复与研判核心（cli / mcp / platform 共享）",
    "author": "CaoMeiYouRen",
    "license": "MIT",
    "type": "module",
    "keywords": [
        "dependabot",
        "security",
        "engine",
        "dependfix"
    ],
    "homepage": "https://github.com/dependfix/dependfix#readme",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/dependfix/dependfix.git"
    },
    "bugs": {
        "url": "https://github.com/dependfix/dependfix/issues"
    },
    "main": "./dist/index.mjs",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.mts",
    "exports": {
        ".": {
            "types": "./dist/index.d.mts",
            "import": "./dist/index.mjs",
            "default": "./dist/index.mjs"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist"
    ],
    "engines": {
        "node": ">=20"
    },
    "scripts": {
        "build": "tsdown",
        "prebuild": "rimraf dist",
        "dev": "tsdown --watch",
        "typecheck": "tsc --noEmit",
        "lint": "eslint . --fix",
        "test": "vitest run"
    },
    "dependencies": {
        "@dependfix/core": "workspace:*",
        "@octokit/request-error": "^5.1.1",
        "@octokit/rest": "^22.0.1",
        "tslib": "^2.8.1"
    },
    "devDependencies": {
        "@types/node": "^26.1.2",
        "nock": "^14.0.17",
        "rimraf": "^6.1.3",
        "tsdown": "^0.22.14",
        "typescript": "^5.9.3"
    },
    "publishConfig": {
        "access": "public"
    }
}
