{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "rootDir": "."
    },
    "include": [
        "packages/*/src/*.ts",
        "packages/*/src/**/*.ts",
        "packages/*/src/**/*.spec.ts",
        "packages/*/src/**/*.test.ts",
        "commitlint.config.ts",
        "packages/*/tsdown.config.ts",
        "vitest.config.ts"
    ],
    "exclude": [
        "node_modules",
        "**/node_modules/*"
    ]
}
