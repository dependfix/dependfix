{
    "compilerOptions": {
        "module": "esnext",
        "target": "esnext",
        "rootDir": ".",
        "noImplicitAny": false,
        "strict": true,
        "allowJs": true,
        "checkJs": true,
        "sourceMap": false,
        "declaration": true,
        "importHelpers": true,
        "strictPropertyInitialization": false,
        "allowSyntheticDefaultImports": true,
        "experimentalDecorators": true,
        "removeComments": false,
        "resolveJsonModule": true,
        "moduleResolution": "bundler",
        "esModuleInterop": true,
        "types": [
            "node"
        ],
        "paths": {
            "@dependfix/core": [
                "./packages/core/src"
            ],
            "@dependfix/core/*": [
                "./packages/core/src/*"
            ],
            "@dependfix/engine": [
                "./packages/engine/src"
            ],
            "@dependfix/engine/*": [
                "./packages/engine/src/*"
            ],
            "dependfix": [
                "./packages/cli/src"
            ]
        },
        "lib": [
            "esnext",
            "dom",
            "dom.iterable",
            "scripthost"
        ],
        "skipLibCheck": true
    },
    "include": [
        "packages/*/src/*.ts",
        "packages/*/src/**/*.ts"
    ],
    "exclude": [
        "node_modules",
        "**/*.test.ts",
        "**/node_modules/*",
        "packages/*/dist"
    ]
}
